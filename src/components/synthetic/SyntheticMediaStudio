import React, { useState } from 'react';
import { useProject } from './ProjectContext';
import {
  Sparkles,
  Cpu,
  ShieldCheck,
  Video,
  Music,
  Image as ImageIcon,
  Layers,
  Wand2,
  Film,
  Download,
  CheckCircle2,
  Lock,
  ArrowRight,
  Loader2,
  RefreshCw,
  Sliders,
  Fingerprint,
  Info,
  Hash,
} from 'lucide-react';
import { SyntheticMediaCategory, SyntheticMediaJob } from './types';

export const SyntheticMediaStudio: React.FC = () => {
  const {
    syntheticMediaJobs,
    generateSyntheticMedia,
    addClip,
    currentTime,
    setActiveTab,
  } = useProject();

  const [activeCategory, setActiveCategory] = useState<SyntheticMediaCategory>('video_diffusion');
  const [prompt, setPrompt] = useState<string>('');
  const [selectedModel, setSelectedModel] = useState<string>('OmniDiffusion-4K-v2');
  const [resolution, setResolution] = useState<string>('1080p');
  const [framerate, setFramerate] = useState<number>(60);
  const [duration, setDuration] = useState<number>(8);
  const [enableC2PAWatermark, setEnableC2PAWatermark] = useState<boolean>(true);
  const [isGenerating, setIsGenerating] = useState<boolean>(false);
  const [selectedJob, setSelectedJob] = useState<SyntheticMediaJob | null>(syntheticMediaJobs[0] || null);

  const samplePromptsByCategory: Record<SyntheticMediaCategory, string[]> = {
    video_diffusion: [
      'A majestic snow leopard prowling across Himalayan crags at dawn, photorealistic 8k 60fps.',
      'Supercar drifting along rain-slicked Tokyo neon highway at midnight, fluid motion reflections.',
      'High-speed macro lens tracking a blooming bioluminescent orchid in a misty Amazonian rainforest.',
      'Astronaut stepping onto the crystalline surface of an alien moon, cinematic volumetric starlight.',
    ],
    voice_clone: [
      'Narrate in a warm British documentary timbre: "Beneath the canopy, life pulses in invisible frequencies."',
      'Deep cinema trailer narrator: "In a world governed by algorithms, one human choice altered everything."',
      'Energetic podcast host tone: "Welcome back! Today we are exploring the frontiers of artificial intelligence."',
    ],
    neural_image: [
      'Photorealistic biological skin texture micro-scan showing cellular pores and subsurface warmth, 8k macro.',
      'Cinematic close-up of an eagle eye showing iris muscle striations and amber corneal reflections.',
      'Hyper-detailed cybernetic forearm revealing titanium tendons and blue fiber-optic circulatory channels.',
    ],
    deep_restyler: [
      'Restyle footage into 35mm Kodachrome 1970s Hollywood film stock with warm grain and analog saturation.',
      'Transform scene into deep neo-noir with high-contrast shadows and rain-slicked specular reflections.',
      'Diffuse video into painterly impressionism with visible oil impasto textures and warm sunlight.',
    ],
    avatar_twin: [
      'Synthesize digital twin delivering breaking global news report with calibrated blink reflexes.',
      'Generate wildlife narrator twin presenting savanna biodiversity with natural pauses and eye saccades.',
    ],
  };

  const handleGenerate = async () => {
    if (!prompt.trim() || isGenerating) return;
    setIsGenerating(true);

    try {
      const job = await generateSyntheticMedia(activeCategory, prompt.trim(), {
        model: selectedModel,
        resolution,
        framerate,
        duration,
        enableC2PAWatermark,
      });

      if (job) {
        setSelectedJob(job);
      }
    } catch (e) {
      console.error('Synthetic generation error:', e);
    } finally {
      setIsGenerating(false);
    }
  };

  const handleDeployToTimeline = (job: SyntheticMediaJob) => {
    if (!job.outputUrl && !job.thumbnailUrl) return;

    if (job.category === 'voice_clone') {
      addClip({
        id: `clip-synth-a1-${Date.now()}`,
        trackId: 'track-a1',
        title: `Synthetic Voice: ${job.title}`,
        type: 'audio',
        start: currentTime,
        duration: job.durationSeconds || 6,
        volume: 0.95,
        speed: 1,
        muted: false,
        color: '#10B981',
        src: job.outputUrl,
        syntheticProvenance: {
          model: job.modelUsed,
          c2paHash: job.provenance.cryptographicHash,
          isSynthetic: true,
          watermarkEnabled: job.provenance.watermarkEnabled,
          generationTimestamp: job.provenance.generationTimestamp,
        },
      } as any);
    } else {
      addClip({
        id: `clip-synth-v1-${Date.now()}`,
        trackId: 'track-v1',
        title: `Synthetic: ${job.title}`,
        type: 'video',
        start: currentTime,
        duration: job.durationSeconds || 8,
        volume: 1,
        speed: 1,
        muted: false,
        color: '#8B5CF6',
        src: job.outputUrl,
        imageSrc: job.thumbnailUrl,
        prompt: job.prompt,
        syntheticProvenance: {
          model: job.modelUsed,
          c2paHash: job.provenance.cryptographicHash,
          isSynthetic: true,
          watermarkEnabled: job.provenance.watermarkEnabled,
          generationTimestamp: job.provenance.generationTimestamp,
        },
      } as any);
    }

    setActiveTab('editor');
  };

  return (
    <div className="flex flex-col h-full bg-zinc-950 border border-zinc-800 rounded-xl overflow-hidden shadow-2xl">
      {/* Header */}
      <div className="p-4 bg-zinc-900 border-b border-zinc-800 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div className="flex items-center gap-2.5">
          <span className="p-2 rounded-lg bg-gradient-to-tr from-purple-600 via-indigo-600 to-cyan-500 text-white shadow-md">
            <Cpu className="w-5 h-5" />
          </span>
          <div>
            <h2 className="text-sm font-bold text-white tracking-wide flex items-center gap-1.5">
              Synthetic Media Studio
              <span className="text-[10px] bg-purple-500/20 text-purple-300 border border-purple-500/30 px-1.5 py-0.2 rounded font-mono">
                C2PA Provenance & Neural Generation
              </span>
            </h2>
            <p className="text-xs text-zinc-400">
              The high-level computer science framework for neural video, audio, and visual assets generated or altered by AI algorithms
            </p>
          </div>
        </div>

        {/* C2PA Provenance badge */}
        <div className="flex items-center gap-1.5 bg-zinc-950 px-3 py-1.5 rounded-xl border border-zinc-800 text-[11px] font-mono text-emerald-400">
          <ShieldCheck className="w-4 h-4 text-emerald-400" />
          <span>C2PA Content Credentials Active</span>
        </div>
      </div>

      <div className="flex-1 grid grid-cols-1 lg:grid-cols-12 gap-4 p-4 overflow-y-auto">
        {/* Left Column: Generation Parameters & Prompt Suite */}
        <div className="lg:col-span-5 flex flex-col gap-4">
          {/* Category Modality Tabs */}
          <div>
            <label className="text-xs font-bold text-zinc-300 uppercase tracking-wider block mb-2">
              Neural Synthesis Modality
            </label>
            <div className="grid grid-cols-2 sm:grid-cols-4 gap-1.5">
              {[
                { id: 'video_diffusion', label: 'Synthetic Video', icon: Video, color: 'text-purple-400' },
                { id: 'voice_clone', label: 'Neural Audio', icon: Music, color: 'text-emerald-400' },
                { id: 'neural_image', label: 'Life Textures', icon: ImageIcon, color: 'text-cyan-400' },
                { id: 'deep_restyler', label: 'AI Restyler', icon: Wand2, color: 'text-pink-400' },
              ].map(cat => {
                const Icon = cat.icon;
                const isSelected = activeCategory === cat.id;
                return (
                  <button
                    key={cat.id}
                    onClick={() => {
                      setActiveCategory(cat.id as any);
                      if (samplePromptsByCategory[cat.id as SyntheticMediaCategory]?.[0]) {
                        setPrompt(samplePromptsByCategory[cat.id as SyntheticMediaCategory][0]);
                      }
                    }}
                    className={`p-2.5 rounded-xl border flex flex-col items-center gap-1.5 transition text-center ${
                      isSelected
                        ? 'bg-zinc-900 border-purple-500 ring-2 ring-purple-500/30 text-white shadow-md'
                        : 'bg-zinc-900/60 border-zinc-800 text-zinc-400 hover:text-white'
                    }`}
                  >
                    <Icon className={`w-4 h-4 ${cat.color}`} />
                    <span className="text-[11px] font-semibold">{cat.label}</span>
                  </button>
                );
              })}
            </div>
          </div>

          {/* Neural Prompt Input */}
          <div className="space-y-1.5">
            <div className="flex items-center justify-between text-xs">
              <label className="text-zinc-300 font-semibold">Generative Neural Prompt:</label>
              <span className="text-[10px] text-zinc-500 font-mono">{prompt.length} chars</span>
            </div>
            <textarea
              rows={4}
              value={prompt}
              onChange={e => setPrompt(e.target.value)}
              placeholder="Describe the asset to synthesize with AI algorithms..."
              className="w-full bg-zinc-900 border border-zinc-800 rounded-xl p-3 text-xs text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-purple-500 resize-none shadow-inner"
            />
          </div>

          {/* Quick Creative Prompt Presets */}
          <div className="space-y-1.5">
            <span className="text-[11px] text-zinc-400 font-medium">Domain Research Benchmarks:</span>
            <div className="flex flex-col gap-1.5">
              {(samplePromptsByCategory[activeCategory] || []).map((sp, idx) => (
                <button
                  key={idx}
                  onClick={() => setPrompt(sp)}
                  className="text-left text-[11px] bg-zinc-900/60 hover:bg-zinc-800/90 border border-zinc-800/80 rounded-lg p-2 text-zinc-300 hover:text-white transition truncate"
                >
                  "{sp}"
                </button>
              ))}
            </div>
          </div>

          {/* Technical Synthesis Matrices */}
          <div className="grid grid-cols-2 sm:grid-cols-3 gap-2.5 bg-zinc-900/40 p-3 rounded-xl border border-zinc-800/80 text-[11px]">
            <div>
              <label className="text-zinc-400 block mb-1">Model Architecture:</label>
              <select
                value={selectedModel}
                onChange={e => setSelectedModel(e.target.value)}
                className="w-full bg-zinc-950 border border-zinc-800 rounded-lg p-1.5 text-xs text-white outline-none cursor-pointer"
              >
                <option value="OmniDiffusion-4K-v2">OmniDiffusion 4K v2</option>
                <option value="NeuralTwin-BioVocal-v3">NeuralTwin BioVocal v3</option>
                <option value="DeepSkin-Texture-8K">DeepSkin Texture 8K</option>
                <option value="LatentFrame-60fps">LatentFrame 60fps</option>
              </select>
            </div>

            <div>
              <label className="text-zinc-400 block mb-1">Target Resolution:</label>
              <select
                value={resolution}
                onChange={e => setResolution(e.target.value)}
                className="w-full bg-zinc-950 border border-zinc-800 rounded-lg p-1.5 text-xs text-white outline-none"
              >
                <option value="1080p">1080p Full HD</option>
                <option value="4K">4K UHD Master</option>
                <option value="720p">720p Mobile Fast</option>
              </select>
            </div>

            <div>
              <label className="text-zinc-400 block mb-1">Frame Rate:</label>
              <select
                value={framerate}
                onChange={e => setFramerate(parseInt(e.target.value, 10))}
                className="w-full bg-zinc-950 border border-zinc-800 rounded-lg p-1.5 text-xs text-white outline-none"
              >
                <option value={60}>60 fps (Fluid Motion)</option>
                <option value={30}>30 fps (Standard)</option>
                <option value={24}>24 fps (Cinematic)</option>
              </select>
            </div>
          </div>

          {/* C2PA Provenance Toggle */}
          <div className="flex items-center justify-between p-2.5 rounded-xl bg-zinc-900/60 border border-zinc-800 text-xs">
            <div className="flex items-center gap-2">
              <ShieldCheck className="w-4 h-4 text-emerald-400" />
              <div>
                <span className="font-semibold text-white block">Cryptographic C2PA Provenance</span>
                <span className="text-[10px] text-zinc-400">Embeds tamper-evident AI metadata manifest</span>
              </div>
            </div>
            <input
              type="checkbox"
              checked={enableC2PAWatermark}
              onChange={e => setEnableC2PAWatermark(e.target.checked)}
              className="w-4 h-4 accent-emerald-500 rounded cursor-pointer"
            />
          </div>

          {/* Generate CTA Button */}
          <button
            onClick={handleGenerate}
            disabled={!prompt.trim() || isGenerating}
            className="w-full py-3 rounded-xl bg-gradient-to-r from-purple-600 via-indigo-600 to-cyan-500 hover:from-purple-500 hover:to-cyan-400 text-white font-bold text-xs shadow-xl transition flex items-center justify-center gap-2 disabled:opacity-50 active:scale-95"
          >
            {isGenerating ? (
              <>
                <Loader2 className="w-4 h-4 animate-spin" />
                Synthesizing Neural Media Asset...
              </>
            ) : (
              <>
                <Sparkles className="w-4 h-4" />
                Execute Neural Synthesis Algorithm
              </>
            )}
          </button>
        </div>

        {/* Right Column: Synthetic Asset Preview & C2PA Provenance Manifest */}
        <div className="lg:col-span-7 flex flex-col gap-4">
          <div className="flex items-center justify-between">
            <span className="text-xs font-bold text-zinc-300 uppercase tracking-wider">
              Synthetic Asset Viewport & Forensics
            </span>
            {selectedJob && (
              <span className="text-[10px] font-mono text-purple-400 bg-purple-950/60 border border-purple-800/60 px-2 py-0.5 rounded">
                ID: {selectedJob.id}
              </span>
            )}
          </div>

          {/* Asset Preview Stage */}
          <div className="relative aspect-video bg-black rounded-xl overflow-hidden border border-zinc-800 shadow-2xl flex items-center justify-center">
            {selectedJob?.outputUrl ? (
              selectedJob.category === 'voice_clone' ? (
                <div className="flex flex-col items-center justify-center gap-3 p-6 text-center">
                  <div className="p-4 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 animate-pulse">
                    <Music className="w-10 h-10" />
                  </div>
                  <div>
                    <span className="font-bold text-white text-sm block">{selectedJob.title}</span>
                    <span className="text-xs text-zinc-400 font-mono mt-1 block">
                      Synthetic Audio • 16-Bit 48kHz Neural Waveform
                    </span>
                  </div>
                  <audio controls src={selectedJob.outputUrl} className="mt-2 w-72" />
                </div>
              ) : (
                <video
                  src={selectedJob.outputUrl}
                  controls
                  autoPlay
                  loop
                  className="w-full h-full object-cover"
                />
              )
            ) : selectedJob?.thumbnailUrl ? (
              <img
                src={selectedJob.thumbnailUrl}
                alt={selectedJob.title}
                className="w-full h-full object-cover"
              />
            ) : (
              <div className="flex flex-col items-center justify-center gap-2 text-zinc-500">
                <Cpu className="w-10 h-10 stroke-[1.2]" />
                <span className="text-xs">No synthetic media selected. Choose from queue or synthesize.</span>
              </div>
            )}

            {/* C2PA Watermark Badge Overlay */}
            {selectedJob?.provenance.watermarkEnabled && (
              <div className="absolute top-3 left-3 bg-zinc-950/85 backdrop-blur-md px-2.5 py-1 rounded-md border border-zinc-700/80 text-[10px] font-mono text-emerald-400 flex items-center gap-1.5 shadow-lg">
                <ShieldCheck className="w-3.5 h-3.5" />
                <span>C2PA: SYNTHESIZED BY AI ({selectedJob.modelUsed})</span>
              </div>
            )}
          </div>

          {/* C2PA Provenance Manifest Deep-Dive */}
          {selectedJob && (
            <div className="bg-zinc-900/60 p-4 rounded-xl border border-zinc-800 space-y-2.5 text-xs">
              <div className="flex items-center justify-between">
                <span className="font-bold text-white flex items-center gap-1.5">
                  <Fingerprint className="w-4 h-4 text-purple-400" />
                  C2PA Cryptographic Content Credentials Manifest
                </span>
                <span className="text-[10px] font-mono text-emerald-400">Verifiable SHA-256</span>
              </div>

              <div className="grid grid-cols-2 gap-2 font-mono text-[11px]">
                <div className="p-2 rounded bg-zinc-950 border border-zinc-800/80">
                  <span className="text-zinc-500 block text-[9px]">Neural Generator Lineage:</span>
                  <span className="text-zinc-200">{selectedJob.modelUsed}</span>
                </div>
                <div className="p-2 rounded bg-zinc-950 border border-zinc-800/80">
                  <span className="text-zinc-500 block text-[9px]">Timestamp:</span>
                  <span className="text-zinc-200">{selectedJob.provenance.generationTimestamp}</span>
                </div>
                <div className="col-span-2 p-2 rounded bg-zinc-950 border border-zinc-800/80 truncate">
                  <span className="text-zinc-500 block text-[9px]">Cryptographic Provenance Hash:</span>
                  <span className="text-purple-300 font-bold">{selectedJob.provenance.cryptographicHash}</span>
                </div>
              </div>

              <div className="flex items-center justify-between pt-1">
                <span className="text-[11px] text-zinc-400 truncate max-w-sm">
                  Prompt: "{selectedJob.prompt}"
                </span>
                <button
                  onClick={() => handleDeployToTimeline(selectedJob)}
                  className="px-4 py-2 rounded-xl bg-purple-600 hover:bg-purple-500 text-white font-bold text-xs shadow transition flex items-center gap-1.5 shrink-0"
                >
                  <Film className="w-3.5 h-3.5" />
                  Add Synthetic Asset to Timeline
                </button>
              </div>
            </div>
          )}

          {/* Synthetic Asset History Gallery */}
          <div className="space-y-2">
            <span className="text-xs font-bold text-zinc-400 uppercase tracking-wider block">
              Synthesized Media Registry ({syntheticMediaJobs.length})
            </span>
            <div className="grid grid-cols-2 sm:grid-cols-3 gap-2.5 max-h-48 overflow-y-auto">
              {syntheticMediaJobs.map(job => (
                <div
                  key={job.id}
                  onClick={() => setSelectedJob(job)}
                  className={`p-2.5 rounded-xl border cursor-pointer transition flex flex-col gap-1.5 ${
                    selectedJob?.id === job.id
                      ? 'bg-zinc-900 border-purple-500 ring-2 ring-purple-500/20'
                      : 'bg-zinc-900/60 border-zinc-800 hover:border-zinc-700'
                  }`}
                >
                  <div className="flex items-center justify-between">
                    <span className="text-[10px] font-mono uppercase text-purple-400 bg-purple-950/60 px-1 rounded">
                      {job.category.replace('_', ' ')}
                    </span>
                    <span className="text-[9px] text-zinc-500 font-mono">
                      {job.durationSeconds ? `${job.durationSeconds}s` : ''}
                    </span>
                  </div>
                  <span className="font-semibold text-white text-xs truncate">{job.title}</span>
                  <span className="text-[10px] text-zinc-400 truncate">{job.prompt}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  );
};
