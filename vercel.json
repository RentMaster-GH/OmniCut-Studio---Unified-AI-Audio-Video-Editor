{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/ai/generate-script",
      "destination": "/api/ai/generate-script"
    },
    {
      "source": "/api/ai/generate-video",
      "destination": "/api/ai/generate-video"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
